{
  "name": "nezha-aurora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aurora - 为哪吒监控 V2 打造的现代用户前端主题",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host",
    "preview:demo": "node preview/demo-server.mjs",
    "package:theme": "node scripts/package-theme.mjs",
    "build:theme": "vite build && node scripts/package-theme.mjs",
    "docker:build": "docker build -t nezha-aurora .",
    "docker:run": "docker run --rm -p 8080:80 -e NEZHA_BACKEND=http://host.docker.internal:8008 nezha-aurora"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "echarts": "^5.6.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.5.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "world-countries": "^5.1.0"
  }
}
